# SafeClick Backend — Environment Variables
# Copy this file to .env and fill in your values.
# The backend functions without any API keys (uses OpenPhish local cache as fallback).

# ── VirusTotal (optional, free API key — https://www.virustotal.com/gui/join-us) ──
# Free tier: 500 requests/day, 4/minute. Leave blank to skip VT and use OpenPhish only.
VIRUSTOTAL_API_KEY=

# ── OpenPhish Feed URL ────────────────────────────────────────────────────────
# Default: public community feed. Uncomment and change if you have a premium feed.
# OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# How long to cache reputation results (seconds). Default 6 hours.
# REPUTATION_CACHE_TTL=21600

# ── Redis (optional) ─────────────────────────────────────────────────────────
# If set, Redis is used for distributed caching. If not set, uses in-process TTL cache.
# REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origins allowed to call this API. For local extension dev, leave as-is.
# CORS_ORIGINS=chrome-extension://

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Phase 5: Database (PostgreSQL) ────────────────────────────────────────────
# Connection string for asyncpg.
# For Docker: postgresql+asyncpg://safeclick:safeclick@localhost:5432/safeclick
# For Supabase/Render free tier: use their provided connection string.
DATABASE_URL=postgresql+asyncpg://safeclick:safeclick@localhost:5432/safeclick

# ── Phase 5: JWT Authentication ───────────────────────────────────────────────
# REQUIRED: generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Phase 5: Rate Limiting ────────────────────────────────────────────────────
# Max report submissions per hour per IP. Defaults to 10.
# REPORT_RATE_LIMIT=10/hour

# ── Phase 5: Threat Intel Aggregation Threshold ───────────────────────────────
# Min independent user reports required before a domain is promoted to shared_threat_intel.
AGGREGATION_MIN_REPORTS=3
# Min Phase 2/3 engine score (0-100) required to corroborate a report for promotion.
AGGREGATION_MIN_ENGINE_SCORE=60
# How often to run the aggregation job (seconds). Default 3600 = 1 hour.
AGGREGATION_INTERVAL_SECONDS=3600

